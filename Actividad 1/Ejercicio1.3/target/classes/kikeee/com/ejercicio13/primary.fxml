<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="420.0" prefWidth="620.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kikeee.com.ejercicio13.PrimaryController">
   <children>
      <Label layoutX="30.0" layoutY="30.0" text="Ingrese un número" />
      <TextField fx:id="txtNumero" layoutX="170.0" layoutY="26.0" prefWidth="150.0" />
      <Button layoutX="350.0" layoutY="26.0" mnemonicParsing="false" onAction="#analizar" prefWidth="110.0" text="Analizar" />
      <Button layoutX="480.0" layoutY="26.0" mnemonicParsing="false" onAction="#limpiar" prefWidth="110.0" text="Limpiar" />

      <Label layoutX="30.0" layoutY="114.0" text="Cantidad de cifras" />
      <TextField fx:id="txtCantidad" editable="false" layoutX="200.0" layoutY="110.0" prefWidth="100.0" />

      <Label layoutX="30.0" layoutY="164.0" text="Suma de cifras impares" />
      <TextField fx:id="txtImpares" editable="false" layoutX="200.0" layoutY="160.0" prefWidth="100.0" />

      <Label layoutX="30.0" layoutY="214.0" text="Suma de cifras pares" />
      <TextField fx:id="txtPares" editable="false" layoutX="200.0" layoutY="210.0" prefWidth="100.0" />

      <Label layoutX="30.0" layoutY="264.0" text="Suma total de cifras" />
      <TextField fx:id="txtTotal" editable="false" layoutX="200.0" layoutY="260.0" prefWidth="100.0" />

      <Label layoutX="30.0" layoutY="314.0" text="Cifra mayor" />
      <TextField fx:id="txtMayor" editable="false" layoutX="200.0" layoutY="310.0" prefWidth="100.0" />

      <Label layoutX="30.0" layoutY="364.0" text="Cifra menor" />
      <TextField fx:id="txtMenor" editable="false" layoutX="200.0" layoutY="360.0" prefWidth="100.0" />

      <Label layoutX="350.0" layoutY="94.0" text="Divisores" />
      <TextArea fx:id="txtDivisores" editable="false" layoutX="350.0" layoutY="115.0" prefHeight="270.0" prefWidth="240.0" />
   </children>
</AnchorPane>