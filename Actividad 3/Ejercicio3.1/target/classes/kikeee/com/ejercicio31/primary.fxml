<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="500.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kikeee.com.ejercicio31.PrimaryController">
   <children>
      <Label alignment="CENTER" layoutX="0.0" layoutY="40.0" prefWidth="500.0" text="Contar número de clics" />
      <TextField fx:id="txtClics" editable="false" focusTraversable="false" layoutX="40.0" layoutY="80.0" prefWidth="420.0" promptText="1" />
      <Button layoutX="195.0" layoutY="140.0" mnemonicParsing="false" onAction="#contar" prefWidth="110.0" text="¡Contar!" />

      <Label alignment="CENTER" layoutX="0.0" layoutY="220.0" prefWidth="500.0" text="Esperar 10 segundos" />
      <ProgressBar fx:id="barra" layoutX="40.0" layoutY="255.0" prefHeight="20.0" prefWidth="420.0" progress="0.0" />
      <Button fx:id="btnEsperar" layoutX="195.0" layoutY="310.0" mnemonicParsing="false" onAction="#esperar" prefWidth="110.0" text="¡Esperar!" />
   </children>
</AnchorPane>