<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="360.0" prefWidth="500.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kikeee.com.ejercicio32.PrimaryController">
   <children>
      <Label alignment="CENTER" layoutX="0.0" layoutY="30.0" prefWidth="500.0" text="La Liebre y la Tortuga" />
      <Button fx:id="btnIniciar" layoutX="180.0" layoutY="75.0" mnemonicParsing="false" onAction="#iniciar" prefWidth="140.0" text="¡Iniciar Carrera!" />

      <Label fx:id="lblLiebre" alignment="CENTER" layoutX="0.0" layoutY="140.0" prefWidth="500.0" text="La Liebre:" />
      <ProgressBar fx:id="barLiebre" layoutX="40.0" layoutY="175.0" prefHeight="20.0" prefWidth="420.0" progress="0.0" />

      <Label fx:id="lblTortuga" alignment="CENTER" layoutX="0.0" layoutY="235.0" prefWidth="500.0" text="La Tortuga:" />
      <ProgressBar fx:id="barTortuga" layoutX="40.0" layoutY="270.0" prefHeight="20.0" prefWidth="420.0" progress="0.0" />
   </children>
</AnchorPane>